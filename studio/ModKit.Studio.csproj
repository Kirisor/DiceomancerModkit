<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ModKit.Studio</AssemblyName>
    <RootNamespace>ModKit.Studio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- contracts 是独立项目，它的 obj/bin 不能被主项目 glob 进来（否则 AssemblyInfo 重复 → CS0579） -->
    <Compile Remove="contracts\**" />
    <None Remove="contracts\**" />
    <Page Remove="contracts\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Studio 直接依赖 ModKit 的源码（同一批 .cs 编成 net8.0 契约库），版本随发布包绑定 -->
    <ProjectReference Include="contracts\ModKit.Contracts.csproj" />
  </ItemGroup>

</Project>
