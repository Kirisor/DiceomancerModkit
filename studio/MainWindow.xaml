<Window x:Class="ModKit.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModKit Studio · 模组制作台" Height="880" Width="1420"
        Background="{StaticResource Paper}"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- 顶：mods 根目录 + 编译 -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="mods 根目录" Foreground="{StaticResource InkSoft}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="新建模组" Click="OnNewModClick" />
            <Button DockPanel.Dock="Right" Content="部署到游戏" Click="OnDeployClick" />
            <Button DockPanel.Dock="Right" Content="编译本 mod" Click="OnCompileModClick" />
            <Button DockPanel.Dock="Right" Content="重新加载" Click="OnReloadClick" />
            <Button DockPanel.Dock="Right" Content="浏览…" Click="OnBrowseClick" />
            <TextBox x:Name="ModsRootBox" VerticalContentAlignment="Center" />
        </DockPanel>



        <!-- 左：模组 / 内容类型 / 内容列表 -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelPaper}" CornerRadius="6" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="模组" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <ListBox x:Name="ModList" Height="110" SelectionChanged="OnModSelected" />

                <TextBlock DockPanel.Dock="Top" Text="内容类型" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,6">
                    <Button x:Name="KindCardBtn" Content="卡牌" Tag="card" Click="OnKindClick" Margin="0,0,4,0" />
                    <Button x:Name="KindRelicBtn" Content="遗物" Tag="relic" Click="OnKindClick" Margin="0,0,4,0" />
                    <Button x:Name="KindKeywordBtn" Content="关键词" Tag="keyword" Click="OnKindClick" Margin="0" />
                </UniformGrid>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="新建" Click="OnNewClick" />
                    <Button Content="删除" Click="OnDeleteClick" />
                </StackPanel>
                <ListBox x:Name="ContentList" Margin="0,0,0,6" SelectionChanged="OnItemSelected" />
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- 中：表单 -->
        <Border Grid.Row="1" Grid.Column="2" Background="#FFFDF7" CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 卡牌 -->
                    <StackPanel x:Name="CardForm" Visibility="Collapsed">
                        <TextBlock Text="卡牌" FontWeight="Bold" FontSize="15" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="id（英文小写，唯一）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CardIdBox" />
                                <TextBlock Text="中文名" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CardNameZhBox" />
                                <TextBlock Text="稀有度" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="RarityBox" />
                                <TextBlock Text="费用（逗号分隔，如 Void,Void 或 3）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CostBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="英文名" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CardNameEnBox" />
                                <TextBlock Text="颜色（逗号分隔）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ColorsBox" />
                                <TextBlock Text="结算时机" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ResolveBox" />
                                <TextBlock Text="美术模板 artTemplate（必须是原版卡名）" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CardArtBox" IsEditable="True" />
                                <TextBlock Text="mod 卡面图 art（本 mod 的 art/*.png，可空）" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="刷新" Click="OnRefreshArtClick" Margin="4,0,0,0" />
                                    <ComboBox x:Name="CardArtFileBox" IsEditable="True" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="关键词" Style="{StaticResource FieldLabel}" />
                        <Grid Height="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                    <ComboBox x:Name="KeywordKindBox" IsEditable="True" Width="150" SelectionChanged="OnKeywordKindChanged" />
                                    <Button Content="新建关键词…" Click="OnCreateKeywordClick" Margin="6,0,0,0" />
                                    <TextBlock Text="参数" VerticalAlignment="Center" Margin="8,0,4,0"
                                               Foreground="{StaticResource InkSoft}" FontSize="12" />
                                    <TextBox x:Name="KeywordNumberBox" Width="56" ToolTip="可空；填了必须是整数" />
                                    <Button Content="添加" Click="OnAddKeywordClick" Margin="6,0,0,0" />
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" Content="删除所选关键词" Click="OnRemoveKeywordClick"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" />
                                <ListBox x:Name="KeywordList" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="关键词 JSON（高级）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox x:Name="KeywordsBox" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </Grid>
                        <TextBlock Text="效果（数字用逗号分隔，如 3 或 1,2）" Style="{StaticResource FieldLabel}" />
                        <Grid Height="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <ComboBox x:Name="EffectKindBox" Width="300" HorizontalAlignment="Left" SelectionChanged="OnEffectKindChanged" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <StackPanel x:Name="EffectTargetGroup" Orientation="Vertical" Margin="0,0,8,0">
                                            <TextBlock x:Name="EffectTargetLabel" Text="模式" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,0,0,2" />
                                            <ComboBox x:Name="EffectTargetBox" Width="104" IsEditable="True" />
                                        </StackPanel>
                                        <StackPanel x:Name="EffectTarget2Group" Orientation="Vertical" Margin="0,0,8,0">
                                            <TextBlock x:Name="EffectTarget2Label" Text="对象" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,0,0,2" />
                                            <ComboBox x:Name="EffectTarget2Box" Width="116" IsEditable="True" />
                                        </StackPanel>
                                        <StackPanel x:Name="EffectAmountGroup" Orientation="Vertical" Margin="0,0,8,0">
                                            <TextBlock x:Name="EffectAmountLabel" Text="数值" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,0,0,2" />
                                            <TextBox x:Name="EffectAmountsBox" Width="60" Text="3" />
                                        </StackPanel>
                                        <Button Content="添加" Click="OnAddEffectClick" VerticalAlignment="Bottom" />
                                    </WrapPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Bottom" Content="删除所选效果" Click="OnRemoveEffectClick"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" />
                                <ListBox x:Name="EffectList" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="效果 JSON（高级）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox x:Name="EffectsBox" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </Grid>
                        <Grid Height="170">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="升级（JSON 对象，可空）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox x:Name="UpgradeBox" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="风味文字（存 i18n FlavorText，可空）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox x:Name="FlavorBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 遗物 -->
                    <StackPanel x:Name="RelicForm" Visibility="Collapsed">
                        <TextBlock Text="遗物" FontWeight="Bold" FontSize="15" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="id（唯一）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RelicIdBox" />
                                <TextBlock Text="中文名" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RelicNameZhBox" />
                                <TextBlock Text="触发点" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="TriggerBox" IsEditable="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="英文名" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RelicNameEnBox" />
                                <TextBlock Text="美术模板（来自本 mod 的 art/）" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="刷新" Click="OnRefreshArtClick" Margin="4,0,0,0" />
                                    <ComboBox x:Name="RelicArtBox" IsEditable="True" />
                                </DockPanel>
                                <CheckBox x:Name="AddToPoolBox" Content="加入遗物池（addToPool）" Margin="0,22,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="效果（用选项添加）" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RelicEffectKindBox" Width="300" HorizontalAlignment="Left" SelectionChanged="OnRelicEffectKindChanged" />
                        <WrapPanel Margin="0,4,0,0">
                            <StackPanel x:Name="RelicEffectTargetGroup" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock x:Name="RelicEffectTargetLabel" Text="模式" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,0,0,2" />
                                <ComboBox x:Name="RelicEffectTargetBox" Width="104" IsEditable="True" />
                            </StackPanel>
                            <StackPanel x:Name="RelicEffectTarget2Group" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock x:Name="RelicEffectTarget2Label" Text="对象" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,0,0,2" />
                                <ComboBox x:Name="RelicEffectTarget2Box" Width="116" IsEditable="True" />
                            </StackPanel>
                            <StackPanel x:Name="RelicEffectAmountGroup" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Text="数值" Foreground="{StaticResource InkSoft}" FontSize="11" Margin="0,0,0,2" />
                                <TextBox x:Name="RelicEffectAmountsBox" Width="60" Text="4" />
                            </StackPanel>
                            <Button Content="添加" Click="OnAddRelicEffectClick" VerticalAlignment="Bottom" />
                        </WrapPanel>
                        <ListBox x:Name="RelicEffectList" Height="86" Margin="0,4,0,4" />
                        <Button Content="删除所选效果" Click="OnRemoveRelicEffectClick" HorizontalAlignment="Left" />
                        <TextBlock Text="效果（JSON，高级）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RelicEffectsBox" AcceptsReturn="True" Height="150" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- 关键词 -->
                    <StackPanel x:Name="KeywordForm" Visibility="Collapsed">
                        <TextBlock Text="关键词" FontWeight="Bold" FontSize="15" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="id（唯一，如 milk_frog）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="KwIdBox" />
                                <TextBlock Text="中文名" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="KwNameZhBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="英文名" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="KwNameEnBox" />
                                <TextBlock Text="（无其它字段）" Style="{StaticResource FieldLabel}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="生成 C# 行为类模板" Click="OnGenerateKeywordClassClick" />
                            <TextBlock x:Name="KeywordClassHint" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{StaticResource InkSoft}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="中文说明（游戏内悬停显示）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="KwDescZhBox" AcceptsReturn="True" Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="英文说明" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="KwDescEnBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="行为类（C#；只有需要真实效果时才写）" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="生成 / 载入行为类" Click="OnLoadKeywordClassClick" />
                            <Button Content="保存行为类" Click="OnSaveKeywordClassClick" />
                            <TextBlock x:Name="KeywordClassPath" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{StaticResource InkSoft}" FontSize="11" />
                        </StackPanel>
                        <TextBox x:Name="KeywordClassBox" AcceptsReturn="True" Height="240"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="保存（含 i18n 同步）" Click="OnSaveClick" />
                        <Button Content="刷新预览" Click="OnPreviewClick" />
                        <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{StaticResource InkSoft}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- 右：预览 -->
        <Border Grid.Row="1" Grid.Column="4" Background="{StaticResource PanelPaper}" CornerRadius="6" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="预览（近似示意）" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />

                <!-- 卡面 -->
                <Viewbox x:Name="CardPreviewHost" Stretch="Uniform">
                    <Border Width="300" Height="430" Background="#F3EAD6" BorderBrush="#2F6B4F" BorderThickness="4" CornerRadius="14">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#2F6B4F" CornerRadius="6" Padding="8,3">
                                <DockPanel>
                                    <TextBlock x:Name="PreviewCost" DockPanel.Dock="Right" Foreground="#F6EFE0" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PreviewName" Foreground="#F6EFE0" FontWeight="Bold" FontSize="17" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Margin="0,8,0,8" Background="#E8E0CC" CornerRadius="8" ClipToBounds="True">
                                <Image x:Name="PreviewArt" Stretch="Uniform" />
                            </Border>
                            <Border Grid.Row="2" Background="#EADFC8" CornerRadius="6" Padding="8" MinHeight="96">
                                <StackPanel>
                                    <TextBlock x:Name="PreviewEffects" TextWrapping="Wrap" FontSize="14" />
                                    <TextBlock x:Name="PreviewKeywords" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                                    <TextBlock x:Name="PreviewFlavor" TextWrapping="Wrap" FontSize="11" FontStyle="Italic"
                                               Foreground="{StaticResource InkSoft}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- 遗物 / 关键词预览 -->
                <StackPanel x:Name="TextPreviewHost" Visibility="Collapsed">
                    <Image x:Name="PreviewRelicIcon" Width="132" Height="132" Stretch="Uniform" Margin="0,0,0,10" />
                    <TextBlock x:Name="PreviewTextTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PreviewTextBody" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource InkSoft}" Text="就绪" />
            <TextBlock x:Name="CompileReport" Text="" Foreground="{StaticResource InkSoft}"
                       FontSize="11" TextWrapping="Wrap" MaxHeight="90" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</Window>
